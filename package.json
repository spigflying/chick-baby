{
  "name": "chick-baby",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @chick/server --filter @chick/web dev",
    "build": "pnpm --filter @chick/web build && pnpm --filter @chick/server build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "migrate": "pnpm --filter @chick/server migrate"
  }
}
