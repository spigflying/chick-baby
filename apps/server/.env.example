DATABASE_URL=postgres://chick:chick@localhost:5432/chick
PORT=8080
# 本機開發：允許 /auth/dev 免 Google 登入（正式環境務必關閉）
DEV_LOGIN=1
GOOGLE_CLIENT_ID=
ADMIN_EMAILS=dev-admin@dev.local
PUBLIC_ORIGIN=http://localhost:5173
# 排程端點以 Google OIDC 驗證；本機（DEV_LOGIN=1）可用 Authorization: Bearer dev-cron
CRON_OIDC_AUDIENCE=
CRON_OIDC_SA_EMAIL=
# 開放時間（requirements §4.7）。不設 = 永遠開放；要在本機試開放時間與睡覺畫面就取消註解：
# OPEN_HOURS=mon-fri 09:00-20:00 Asia/Taipei
